# Supabase (existing project). The anon key is used ONLY by server-side auth calls.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Public origin of this panel (used for the same-origin check and email redirects)
HUB_URL=http://localhost:3000
# >= 32 random chars; signs the session-timing and step-up cookies
SESSION_SECRET=
# The first successful password login with this email creates the first owner (only while no admin exists)
INITIAL_OWNER_EMAIL=
# Optional: the bot's token, SERVER ONLY. Used read-only to look up server names and icons (never shown or logged).
DISCORD_BOT_TOKEN=
# Optional: deep links to the Polar dashboard
POLAR_DASHBOARD_ORG_SLUG=

# Polar API access token, SERVER ONLY. Must belong to the same environment as POLAR_ENV.
POLAR_ACCESS_TOKEN=
# production (live payments, polar.sh) or sandbox (test payments, sandbox.polar.sh). Defaults to production.
POLAR_ENV=production

# WooFlowConnect licence server (SERVER ONLY). Create the key in its /admin panel, API keys tab.
# Use a read-only key unless you want support actions (suspend, grant days...) from this panel.
WFC_API_KEY=
# Optional, defaults to https://wooflowconnect.duoplus.org/api/ext/v1
WFC_API_BASE=
# Optional: Polar organisation slug for WooFlowConnect payment links (falls back to POLAR_DASHBOARD_ORG_SLUG)
WFC_POLAR_ORG_SLUG=
