# Supabase (existing project). The anon key is used ONLY by server-side auth calls.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Public origin of this panel (used for the same-origin check and email redirects)
HUB_URL=http://localhost:3000
# >= 32 random chars; signs the session-timing and step-up cookies
SESSION_SECRET=
# The first successful password login with this email creates the first owner (only while no admin exists)
INITIAL_OWNER_EMAIL=
# Optional: the bot's token, SERVER ONLY. Used read-only to look up server names and icons (never shown or logged).
DISCORD_BOT_TOKEN=
# Optional: deep links to the Polar dashboard
POLAR_DASHBOARD_ORG_SLUG=
