# Supabase (existing project). The anon key is used ONLY by server-side auth calls.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY - never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Public origin of this panel (used for the same-origin check and email redirects)
HUB_URL=http://localhost:3000
# >= 32 random chars; signs the session-timing and step-up cookies
SESSION_SECRET=
# The first successful password login with this email creates the first owner (only while no admin exists)
INITIAL_OWNER_EMAIL=
# Optional: the bot's token, SERVER ONLY. Used read-only to look up server names and icons (never shown or logged).
DISCORD_BOT_TOKEN=
# Optional: deep links to the Polar dashboard
DISCONOTIFY_POLAR_ORG_SLUG=

# Which Polar the panel follows for the DiscoNotify bot. It MUST equal the bot's own POLAR_SANDBOX.
#   false / unset = live    (api.polar.sh, polar.sh dashboard)
#   true          = sandbox (sandbox-api.polar.sh, sandbox.polar.sh: a separate account, org, product and token)
# Payments from the other environment are kept out of this mode's totals. The older DISCONOTIFY_POLAR_ENV=sandbox (and the unprefixed POLAR_* names) still work.
DISCONOTIFY_POLAR_SANDBOX=false
# Polar API access token, SERVER ONLY, from the SAME environment as DISCONOTIFY_POLAR_SANDBOX. Read-only scopes only:
# subscriptions:read, orders:read, customers:read. The panel never writes to Polar. A live token gets a 401 on sandbox and vice versa.
DISCONOTIFY_POLAR_ACCESS_TOKEN=

# WooFlowConnect licence server (SERVER ONLY). Create the key in its /admin panel, API keys tab.
# Use a read-only key unless you want support actions (suspend, grant days...) from this panel.
WFC_API_KEY=
# Optional, defaults to https://wooflowconnect.duoplus.org/api/ext/v1
WFC_API_BASE=
# Optional: Polar organisation slug for WooFlowConnect payment links (falls back to DISCONOTIFY_POLAR_ORG_SLUG)
WFC_POLAR_ORG_SLUG=

# Donexel operator API. SERVER ONLY, never exposed to the browser. (The older DUOPLUS_API_URL / DUOPLUS_ADMIN_KEY names still work.)
# The API's domain, for example https://api.example.com (the /api/v1/admin path is added for you).
DONEXEL_API_URL=
# Must equal ADMIN_API_KEY on that API. Treat it as a master key: never log it, never commit it.
DONEXEL_ADMIN_KEY=
# production (polar.sh) or sandbox (sandbox.polar.sh), matching that app's POLAR_SERVER. Defaults to production.
DONEXEL_POLAR_ENV=
# Optional: Polar organisation slug for its dashboard links (falls back to DISCONOTIFY_POLAR_ORG_SLUG)
DONEXEL_POLAR_ORG_SLUG=
# Polar API token to read that app's orders (Payments page). SERVER ONLY. Needs order read access and must come from the
# same Polar environment as DONEXEL_POLAR_ENV. If empty, DISCONOTIFY_POLAR_ACCESS_TOKEN is used when both are the same environment.
DONEXEL_POLAR_ACCESS_TOKEN=
# Optional: comma-separated Polar product IDs for Starter, Growth and Scale. Without them plans are matched by product name.
DONEXEL_POLAR_PRODUCT_IDS=
